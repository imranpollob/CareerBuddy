# No AWS keys belong in this file. Use the standard AWS credential chain.
SKILLPILOT_AI_MODE=mock
SKILLPILOT_REPOSITORY=memory
# Set to the region verified by scripts/aws_preflight.py before using Bedrock.
AWS_REGION=us-east-1
SKILLPILOT_MODEL_ID=us.amazon.nova-2-lite-v1:0
SKILLPILOT_TABLE_NAME=SkillPilot
# Only needed with SKILLPILOT_REPOSITORY=dynamodb-local:
SKILLPILOT_DYNAMODB_ENDPOINT=http://localhost:8001
# Precreated actor credentials are generated privately on first startup.
SKILLPILOT_SEED_ACCOUNTS=true
SKILLPILOT_ACTOR_CREDENTIALS_PATH=.local/actor-accounts.json
# Set true when serving through HTTPS. Keep false for localhost HTTP.
SKILLPILOT_SECURE_COOKIES=false
